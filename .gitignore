# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / tooling
/.claude
/.vscode
/.idea

# intermediate data drafts (not used by the app)
# scraper drafts: only the league drafts are kept (they are the source of
# src/data/matches-ligler.ts and matches-derbiler.ts; see scripts/leagues-to-ts.mjs)
/data-drafts/*
!/data-drafts/league-*.json

# Transfermarkt match-sheet cache (scripts/build-league-derbies.mjs)
scripts/.cache/tm/

# quiz levels/standings written by server.js
/data
# club-season squads for teammates (scripts/tiki-scrape-seasons.mjs), large and re-scrapable
scripts/.cache/raw-seasons.json
scripts/.cache/tm-coaches/
scripts/.cache/raw-coaches.json
scripts/.cache/raw-positions.json
scripts/.cache/raw-wikidata.json

# full-size card art originals (14 MB); the app copies live in mobile/assets/brand/taktik/aug
/docs/design/taktik-card-art/originals/

# full-size screen art (mockups and 1024 px parts); the app copies live in mobile/assets/brand/taktik/ui
/docs/design/taktik-screen-art/
/docs/design/taktik-screen-art-v2/*.png
!/docs/design/taktik-screen-art-v2/preview-*.png
/docs/design/taktik-pitch-art/
