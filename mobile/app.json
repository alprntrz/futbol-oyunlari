        {
          "backgroundColor": "#F2F4F7",
          "image": "./assets/brand/splash-logo.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.360213444851-nj294lghif6tnt08rn7tb7i9u6sukkj4"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Tiktako lets you pick a profile photo. It stays on your phone and is never uploaded.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withApsProduction",
      [
        "expo-widgets",
        {
          "enablePushNotifications": true
        }
      ],
      [
        "expo-notifications",
        {
