{
  "expo": {
    "name": "Tiktako",
    "slug": "tiktako",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "tiktako",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/brand/app-icon.png",
      "bundleIdentifier": "com.alprntrz.tiktako",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Tiktako"
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16A34A",
        "foregroundImage": "./assets/brand/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.alprntrz.tiktako",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/icon-team.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F4F7",
          "image": "./assets/brand/splash-logo.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE-WITH-IOS-CLIENT-ID"
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#F2F4F7",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5400971b-df0a-49b3-a040-59109e62fa30"
      }
    },
    "owner": "alperenterzi"
  }
}
