{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal" },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_SOCKET_URL": "https://REPLACE-WITH-SERVER-URL" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_SOCKET_URL": "https://REPLACE-WITH-SERVER-URL" }
    }
  },
  "submit": { "production": {} }
}
