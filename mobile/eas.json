{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SOCKET_URL": "https://tiktako.fly.dev"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SOCKET_URL": "https://tiktako.fly.dev"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6821740252",
        "metadataPath": "./store.config.js"
      }
    }
  }
}
