{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SOCKET_URL": "https://tiktako.fly.dev",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "360213444851-nj294lghif6tnt08rn7tb7i9u6sukkj4.apps.googleusercontent.com"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SOCKET_URL": "https://tiktako.fly.dev",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "360213444851-nj294lghif6tnt08rn7tb7i9u6sukkj4.apps.googleusercontent.com"
      },
      "channel": "production"
    },
    "simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6821740252",
        "metadataPath": "./store.config.js"
      }
    }
  }
}
